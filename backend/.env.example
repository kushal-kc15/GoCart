# Copy this file to .env (same folder) and fill it in. Never commit .env.
# Leave the values empty to print emails in the runserver terminal instead.
#
# EMAIL_HOST_USER: the Gmail address the codes are sent from.
# EMAIL_HOST_PASSWORD: a 16-letter Gmail App Password (not the normal password),
#   typed without spaces. Google Account > Security > 2-Step Verification > App passwords.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
